# ============================================================
# 这是模板，只用来告诉别人"需要配置哪些变量"。
# 请先复制成 .env 再填你的真实 key：  cp .env.example .env
# 不要在 .env.example 里填真实 key（它会被公开提交）。
# ============================================================

# ---- Anthropic 格式（默认，--provider anthropic）----

# 填入你的 API Key（Ollama 云 / Anthropic 官方均可）
ANTHROPIC_AUTH_TOKEN=sk-ant-...

# Anthropic Messages API 地址
# Ollama 云：https://ollama.com
# Anthropic 官方：https://api.anthropic.com
ANTHROPIC_BASE_URL=https://ollama.com

# 默认模型（Ollama 云常见：deepseek-v4-flash:0731；Anthropic 官方：claude-sonnet-5 等）
ANTHROPIC_MODEL=deepseek-v4-flash:0731

# ---- OpenAI 兼容格式（可选，--provider openai）----
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat
