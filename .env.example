# ============================================================
# 这是模板，只用来告诉别人"需要配置哪些变量"。
# 请先复制成 .env 再填你的真实 key：  cp .env.example .env
# 不要在 .env.example 里填真实 key（它会被公开提交）。
# ============================================================

# 填入你的 API Key（OpenAI、DeepSeek、通义等兼容接口均可）
OPENAI_API_KEY=sk-...

# OpenAI 兼容接口地址（DeepSeek / 通义 / Ollama 等改成各自地址）
# DeepSeek 官方：https://api.deepseek.com/v1
OPENAI_BASE_URL=https://api.deepseek.com/v1

# 默认模型（DeepSeek 官方常见：deepseek-chat / deepseek-reasoner）
OPENAI_MODEL=deepseek-chat
